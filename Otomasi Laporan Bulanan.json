      "parameters": {
        "jsCode": "// Trim spasi pada semua teks & pastikan kolom angka bertipe number\nconst angka = ['Jumlah Stok', 'Penjualan Harian', 'Harga Satuan (IDR)', 'Total Penjualan (IDR)'];\n\nreturn $input.all().map(item => {\n  const row = {};\n  for (const [key, value] of Object.entries(item.json)) {\n    row[key.trim()] = typeof value === 'string' ? value.trim() : value;\n  }\n  angka.forEach(k => {\n    if (row[k] !== undefined) {\n      row[k] = parseFloat(String(row[k]).replace(/[^0-9.\\-]/g, '')) || 0;\n    }\n  });\n  return { json: row };\n});"
      },
