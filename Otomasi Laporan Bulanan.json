    {
      "parameters": {
        "jsCode": "const jumlahSheet1 = $('Data Sheet 1').all().length;\n\nreturn $input.all().map((item, i) => {\n  const { row_number, ...data } = item.json;\n  return {\n    json: { ...data, Sumber: i < jumlahSheet1 ? 'Sheet 1' : 'Sheet 2' }\n  };\n});"
      },
      "id": "6745c1ee-e21a-456d-8834-c67e8fbc58b4",
      "name": "Menambahkan Kolom Sumber",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        976
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agregasi bulan berjalan: total & rata-rata\nconst BULAN_MANUAL = ''; // isi mis. 'Maret' jika ingin memaksa bulan tertentu, kosongkan untuk otomatis\n\nconst semuaBaris = $input.all().flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\n\n// Buang baris ganda berdasarkan ID Laporan (jaga-jaga data Sheet 3 masuk dari 2 jalur)\nconst sudahAda = new Set();\nconst allRows = semuaBaris.filter(r => {\n  const id = r['ID Laporan'];\n  if (!id) return true;\n  if (sudahAda.has(id)) return false;\n  sudahAda.add(id);\n  return true;\n});\n\nconst namaBulan = ['Januari','Februari','Maret','April','Mei','Juni',\n                   'Juli','Agustus','September','Oktober','November','Desember'];\nconst now = new Date();\nconst bulanIni = BULAN_MANUAL || namaBulan[now.getMonth()];\nconst tahun = now.getFullYear();\n\nconst monthlyData = allRows.filter(r =>\n  String(r['Bulan'] || '').trim().toLowerCase() === bulanIni.toLowerCase()\n);\n\nconst totalPenjualan = monthlyData.reduce((s, r) => s + (parseFloat(r['Penjualan (Unit)']) || 0), 0);\nconst totalPendapatan = monthlyData.reduce((s, r) => s + (parseFloat(r['Pendapatan (IDR)']) || 0), 0);\nconst jumlah = monthlyData.length;\n\nconst laporan = {\n  'Periode': `${bulanIni} ${tahun}`,\n  'Total Penjualan (Unit)': totalPenjualan,\n  'Total Pendapatan (IDR)': totalPendapatan,\n  'Rata-rata Penjualan': jumlah ? Math.round(totalPenjualan / jumlah) : 0,\n  'Rata-rata Pendapatan': jumlah ? Math.round(totalPendapatan / jumlah) : 0,\n  'Jumlah Transaksi': jumlah\n};\n\nreturn [{ json: laporan }];"
      },
